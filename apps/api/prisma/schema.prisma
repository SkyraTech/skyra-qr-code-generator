// ==============================================================================
// SkyraQR — Authoritative Prisma Database Schema
// Document Identifier: SKYRA-DOC-DB-001 | Version: 2.2.0
// 57 Production Relational Tables across 12 Functional Groups
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto]
}

// ==============================================================================
// Group 1: Identity, Authentication & Sessions (6 Tables)
// ==============================================================================

model User {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(100)
  avatarUrl          String?   @map("avatar_url") @db.Text
  isVerified         Boolean   @default(false) @map("is_verified")
  isActive           Boolean   @default(true) @map("is_active")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  sessions                  UserSession[]
  authIdentities            AuthIdentity[]
  mfaSettings               UserMfaSetting?
  authAuditLogs             AuthAuditLog[]
  workspaceMemberships      WorkspaceMember[]
  qrCodesCreated            QrCode[]               @relation("QrCodesCreated")
  qrVersionsCreated         QrVersion[]            @relation("QrVersionsCreated")
  mcpCredentials            McpCredential[]        @relation("McpCredentialUser")
  mcpCredentialsCreated     McpCredential[]        @relation("McpCredentialCreatedBy")
  mcpCredentialsUpdated     McpCredential[]        @relation("McpCredentialUpdatedBy")
  mcpCredentialsRevoked     McpCredential[]        @relation("McpCredentialRevokedBy")
  mcpInvocationLogs         McpInvocationLog[]     @relation("McpInvocationsUser")
  mcpPendingActionsConfirmed McpPendingAction[]    @relation("McpPendingActionsConfirmed")
  auditLogs                 AuditLog[]             @relation("AuditLogsActor")

  @@map("users")
}

model UserSession {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  userAgent         String?  @map("user_agent") @db.Text
  clientIp          String?  @map("client_ip") @db.Inet
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(64)
  lastActiveAt      DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, expiresAt], name: "idx_user_sessions_user_expires")
  @@map("user_sessions")
}

model RefreshToken {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sessionId          String    @map("session_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.VarChar(64)
  isRevoked          Boolean   @default(false) @map("is_revoked")
  replacedByTokenId  String?   @map("replaced_by_token_id") @db.Uuid
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session          UserSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedByToken  RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replacesTokens   RefreshToken[] @relation("TokenRotation")

  @@index([tokenHash], name: "idx_refresh_tokens_hash")
  @@map("refresh_tokens")
}

model AuthIdentity {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(50)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerUserId], name: "uq_auth_identities_provider_user")
  @@index([userId], name: "idx_auth_identities_user")
  @@map("auth_identities")
}

model UserMfaSetting {
  id                   String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  totpSecretEncrypted  String    @map("totp_secret_encrypted") @db.Text
  backupCodesHashed    String[]  @map("backup_codes_hashed")
  isEnabled            Boolean   @default(false) @map("is_enabled")
  enabledAt            DateTime? @map("enabled_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], name: "idx_user_mfa_user_id")
  @@map("user_mfa_settings")
}

model AuthAuditLog {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(60)
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)], name: "idx_auth_audit_user_time")
  @@map("auth_audit_logs")
}

// ==============================================================================
// Group 2: Tenancy, Workspaces & Customer RBAC (6 Tables)
// ==============================================================================

model Workspace {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name             String    @db.VarChar(100)
  slug             String    @unique @db.VarChar(60)
  tier             String    @default("FREE") @db.VarChar(30)
  status           String    @default("ACTIVE") @db.VarChar(30)
  whiteLabelLogo   String?   @map("white_label_logo") @db.Text
  whiteLabelTheme  Json      @default("{}") @map("white_label_theme")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Direct tenant scoped relations
  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  roles                Role[]
  qrCodes              QrCode[]
  qrFolders            QrFolder[]
  qrGenerationJobs     QrGenerationJob[]
  landingPages         LandingPage[]
  digitalAssets        DigitalAsset[]
  campaigns            Campaign[]
  scanEvents           ScanEvent[]
  dailyScanMetrics     DailyScanMetric[]
  subscription         Subscription?
  usageMeters          UsageMeter[]
  usageAlerts          UsageAlert[]
  subscriptionInvoices SubscriptionInvoice[]
  customDomains        CustomDomain[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  mcpRoles             McpRole[]
  mcpCredentials       McpCredential[]
  mcpInvocationLogs    McpInvocationLog[]
  mcpPendingActions    McpPendingAction[]
  auditLogs            AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("EDITOR") @db.VarChar(30)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, userId], name: "uq_workspace_member")
  @@index([userId], name: "idx_workspace_members_user")
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  email       String   @db.VarChar(255)
  role        String   @default("VIEWER") @db.VarChar(30)
  token       String   @unique @db.VarChar(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([token], name: "idx_workspace_invitations_token")
  @@map("workspace_invitations")
}

model Role {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  name            String   @db.VarChar(60)
  isSystemDefault Boolean  @default(false) @map("is_system_default")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissions RolePermission[]

  @@unique([workspaceId, name], name: "uq_roles_workspace_name")
  @@index([workspaceId], name: "idx_roles_workspace")
  @@map("roles")
}

model Permission {
  id          String   @id @db.VarChar(60)
  category    String   @db.VarChar(40)
  description String   @db.Text

  rolePermissions RolePermission[]

  @@index([category], name: "idx_permissions_category")
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.VarChar(60)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==============================================================================
// Group 3: Platform Owner Administration & Operations (5 Tables)
// ==============================================================================

model PlatformUser {
  id                  String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email               String   @unique @db.VarChar(255)
  passwordHash        String   @map("password_hash") @db.VarChar(255)
  fullName            String   @map("full_name") @db.VarChar(100)
  mfaEnabled          Boolean  @default(true) @map("mfa_enabled")
  totpSecretEncrypted String   @map("totp_secret_encrypted") @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles     PlatformUserRole[]
  auditLogs PlatformAuditLog[]

  @@index([email], name: "idx_platform_users_email")
  @@map("platform_users")
}

model PlatformRole {
  id          String @id @db.VarChar(40)
  description String @db.Text

  userRoles PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String @id @db.VarChar(60)
  description String @db.Text

  @@map("platform_permissions")
}

model PlatformUserRole {
  platformUserId String @map("platform_user_id") @db.Uuid
  platformRoleId String @map("platform_role_id") @db.VarChar(40)

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([platformUserId, platformRoleId])
  @@map("platform_user_roles")
}

model PlatformAuditLog {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  platformUserId   String   @map("platform_user_id") @db.Uuid
  action           String   @db.VarChar(80)
  targetResource   String   @map("target_resource") @db.VarChar(50)
  targetResourceId String?  @map("target_resource_id") @db.Uuid
  metadata         Json     @default("{}")
  ipAddress        String   @map("ip_address") @db.Inet
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt(sort: Desc)], name: "idx_platform_audit_time")
  @@map("platform_audit_logs")
}

// ==============================================================================
// Group 4: QR Code Core Management & Design (7 Tables)
// ==============================================================================

model QrType {
  id        String  @id @db.VarChar(40)
  category  String  @db.VarChar(40)
  isDynamic Boolean @map("is_dynamic")
  minTier   String  @default("FREE") @map("min_tier") @db.VarChar(30)

  qrCodes QrCode[]

  @@map("qr_types")
}

model QrCode {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  folderId          String?   @map("folder_id") @db.Uuid
  qrTypeId          String    @map("qr_type_id") @db.VarChar(40)
  shortCode         String    @unique @map("short_code") @db.VarChar(16)
  name              String    @db.VarChar(150)
  isDynamic         Boolean   @default(true) @map("is_dynamic")
  status            String    @default("ACTIVE") @db.VarChar(30)
  totalScans        BigInt    @default(0) @map("total_scans")
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  scannabilityScore Int       @default(100) @map("scannability_score")
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  folder        QrFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  qrType        QrType           @relation(fields: [qrTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User?            @relation("QrCodesCreated", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  destination   QrDestination?
  design        QrDesign?
  versions      QrVersion[]
  redirectRules RedirectRule[]
  healthChecks  QrHealthCheck[]
  landingPages  LandingPage[]
  campaignQrs   CampaignQr[]
  scanEvents    ScanEvent[]
  dailyMetrics  DailyScanMetric[]

  @@index([workspaceId, status, createdAt(sort: Desc)], name: "idx_qr_codes_workspace_status")
  @@map("qr_codes")
}

model QrDestination {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  qrId           String    @unique @map("qr_id") @db.Uuid
  targetUrl      String    @map("target_url") @db.Text
  utmSource      String?   @map("utm_source") @db.VarChar(100)
  utmMedium      String?   @map("utm_medium") @db.VarChar(100)
  utmCampaign    String?   @map("utm_campaign") @db.VarChar(100)
  healthStatus   String    @default("HEALTHY") @map("health_status") @db.VarChar(30)
  lastCheckedAt  DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastHttpStatus Int?      @default(200) @map("last_http_status")

  qrCode QrCode @relation(fields: [qrId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([qrId], name: "idx_qr_destinations_qr_id")
  @@map("qr_destinations")
}

model QrDesign {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  qrId              String   @unique @map("qr_id") @db.Uuid
  eccLevel          String   @default("M") @map("ecc_level") @db.VarChar(2)
  modulePattern     String   @default("square") @map("module_pattern") @db.VarChar(40)
  eyeShape          String   @default("square") @map("eye_shape") @db.VarChar(40)
  eyePupil          String   @default("square") @map("eye_pupil") @db.VarChar(40)
  fgColor           String   @default("#000000") @map("fg_color") @db.VarChar(20)
  bgColor           String   @default("#FFFFFF") @map("bg_color") @db.VarChar(20)
  gradientType      String?  @map("gradient_type") @db.VarChar(20)
  gradientSecondary String?  @map("gradient_secondary") @db.VarChar(20)
  logoUrl           String?  @map("logo_url") @db.Text
  logoScale         Decimal  @default(0.20) @map("logo_scale") @db.Decimal(3, 2)
  frameStyle        String?  @map("frame_style") @db.VarChar(50)
  frameText         String?  @map("frame_text") @db.VarChar(60)
  stylingPayload    Json     @default("{}") @map("styling_payload")

  qrCode QrCode @relation(fields: [qrId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("qr_designs")
}

model QrVersion {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  qrId            String   @map("qr_id") @db.Uuid
  versionNumber   Int      @default(1) @map("version_number")
  snapshotPayload Json     @map("snapshot_payload")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  qrCode        QrCode @relation(fields: [qrId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser User?  @relation("QrVersionsCreated", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([qrId, versionNumber(sort: Desc)], name: "idx_qr_versions_qr_id")
  @@map("qr_versions")
}

model QrFolder {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  parentFolderId String?  @map("parent_folder_id") @db.Uuid
  name           String   @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentFolder QrFolder?  @relation("QrFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  childFolders QrFolder[] @relation("QrFolderHierarchy")
  qrCodes      QrCode[]

  @@index([workspaceId], name: "idx_qr_folders_workspace")
  @@map("qr_folders")
}

model QrGenerationJob {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  totalRecords     Int      @map("total_records")
  processedRecords Int      @default(0) @map("processed_records")
  status           String   @default("PENDING") @db.VarChar(30)
  downloadZipUrl   String?  @map("download_zip_url") @db.Text
  errorSummary     Json?    @map("error_summary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workspaceId, status], name: "idx_qr_generation_jobs_ws")
  @@map("qr_generation_jobs")
}

// ==============================================================================
// Group 5: Dynamic Routing & Health Defense (2 Tables)
// ==============================================================================

model RedirectRule {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  qrId             String   @map("qr_id") @db.Uuid
  ruleType         String   @map("rule_type") @db.VarChar(30)
  priority         Int      @default(0)
  conditionPayload Json     @map("condition_payload")
  destinationUrl   String   @map("destination_url") @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  qrCode QrCode @relation(fields: [qrId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("redirect_rules")
}

model QrHealthCheck {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  qrId           String   @map("qr_id") @db.Uuid
  httpStatus     Int      @map("http_status")
  responseTimeMs Int      @map("response_time_ms")
  errorMessage   String?  @map("error_message") @db.Text
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  qrCode QrCode @relation(fields: [qrId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([qrId, checkedAt(sort: Desc)], name: "idx_qr_health_checks_qr")
  @@map("qr_health_checks")
}

// ==============================================================================
// Group 6: No-Code Micro-Landing Pages & Content (6 Tables)
// ==============================================================================

model LandingPage {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  qrId            String   @unique @map("qr_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  pageType        String   @map("page_type") @db.VarChar(40)
  title           String   @db.VarChar(150)
  metaDescription String?  @map("meta_description") @db.Text
  themeSettings   Json     @default("{}") @map("theme_settings")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  qrCode       QrCode        @relation(fields: [qrId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  menu         Menu?
  vcardProfile VcardProfile?

  @@index([workspaceId], name: "idx_landing_pages_workspace")
  @@map("landing_pages")
}

model Menu {
  id             String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  landingPageId  String  @unique @map("landing_page_id") @db.Uuid
  currency       String  @default("USD") @db.VarChar(3)
  allowAllergens Boolean @default(true) @map("allow_allergens")

  landingPage LandingPage    @relation(fields: [landingPageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categories  MenuCategory[]

  @@map("menus")
}

model MenuCategory {
  id           String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  menuId       String @map("menu_id") @db.Uuid
  name         String @db.VarChar(100)
  displayOrder Int    @default(0) @map("display_order")

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items MenuItem[]

  @@index([menuId, displayOrder], name: "idx_menu_categories_menu")
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url") @db.Text
  dietaryTags String[] @default([]) @map("dietary_tags")
  isAvailable Boolean  @default(true) @map("is_available")

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([categoryId], name: "idx_menu_items_category")
  @@map("menu_items")
}

model VcardProfile {
  id            String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  landingPageId String  @unique @map("landing_page_id") @db.Uuid
  firstName     String  @map("first_name") @db.VarChar(60)
  lastName      String? @map("last_name") @db.VarChar(60)
  organization  String? @db.VarChar(100)
  jobTitle      String? @map("job_title") @db.VarChar(100)
