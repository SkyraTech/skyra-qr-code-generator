  workspaceId     String?  @map("workspace_id") @db.Uuid
  name            String   @db.VarChar(60)
  description     String?  @db.Text
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissions McpRolePermission[]
  credentials McpCredential[]

  @@unique([workspaceId, name], name: "uq_mcp_roles_workspace_name")
  @@map("mcp_roles")
}

model McpPermission {
