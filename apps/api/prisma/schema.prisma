  @@map("mcp_permissions")
}

model McpRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.VarChar(60)

  role       McpRole       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission McpPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@map("mcp_role_permissions")
}

model McpCredential {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  name             String    @db.VarChar(80)
  tokenPrefix      String    @map("token_prefix") @db.VarChar(14)
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  roleId           String    @map("role_id") @db.Uuid
  startsAt         DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  status           String    @default("ACTIVE") @db.VarChar(30)
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?   @map("updated_by_user_id") @db.Uuid
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user            User                      @relation("McpCredentialUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role            McpRole                   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User                      @relation("McpCredentialCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedByUser   User?                     @relation("McpCredentialUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  revokedByUser   User?                     @relation("McpCredentialRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  permissions     McpCredentialPermission[]
  invocationLogs  McpInvocationLog[]
  pendingActions  McpPendingAction[]

  @@index([tokenHash], name: "idx_mcp_credentials_hash")
  @@index([workspaceId, status], name: "idx_mcp_credentials_workspace")
  @@map("mcp_credentials")
}

model McpCredentialPermission {
  mcpCredentialId String  @map("mcp_credential_id") @db.Uuid
  permissionId    String  @map("permission_id") @db.VarChar(60)
  isGranted       Boolean @default(true) @map("is_granted")

  credential McpCredential @relation(fields: [mcpCredentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission McpPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([mcpCredentialId, permissionId])
  @@map("mcp_credential_permissions")
}

model McpInvocationLog {
  id                  String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  mcpCredentialId     String   @map("mcp_credential_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  toolName            String   @map("tool_name") @db.VarChar(60)
  toolClassification  String   @map("tool_classification") @db.VarChar(20)
