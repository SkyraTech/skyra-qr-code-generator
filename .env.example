# ==============================================================================
# SkyraQR — Environment Configuration Template (.env.example)
# Internal Codename: SkyraQR | Parent: Skyra Tech
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="SkyraQR"

# ------------------------------------------------------------------------------
# 3. Database Configuration (Supabase PostgreSQL - Future Phase Integration)
# ------------------------------------------------------------------------------
# Transaction pooler URL (PgBouncer mode on port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session URL (Port 5432 for schema migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 4. Security & Cryptography (NestJS Server-Side Only)
# ------------------------------------------------------------------------------
# Secrets must NEVER be exposed to browser / client code!
JWT_ACCESS_SECRET="dev_access_secret_super_secure_change_in_production_min32chars"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_change_in_production_min32chars"
ENCRYPTION_KEY_32BYTES="0123456789abcdef0123456789abcdef"
